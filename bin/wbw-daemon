#!/bin/bash
set -e

echo "Bootstrapping wbw-daemon..."

# 1. Check authorization
if ! gcloud auth print-access-token >/dev/null 2>&1; then
    echo "ERROR: Not authorized. Please run 'gcloud auth login' before starting the daemon." >&2
    exit 1
fi
echo "GCP Authorization verified."

# 2. Ensure AGY_OPERATOR_ID is set
if [ -z "$AGY_OPERATOR_ID" ]; then
    echo "ERROR: AGY_OPERATOR_ID environment variable is not set." >&2
    exit 1
fi

# 3. Retrieve payload from Warlock and write to rules/identity.local.md
# Resolve real path in case this is executed via symlink in ~/.local/bin
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
IDENTITY_FILE="$SCRIPT_DIR/../rules/identity.local.md"

# Ensure the rules directory exists
mkdir -p "$(dirname "$IDENTITY_FILE")"

# Hardcode to the Mayor's preferred custom domain
WARLOCK_API_URL="https://warlock-nprd.worksbyworrell.com"

# Extract the identity ruleset via Warlock's new REST fallback endpoint
echo "Fetching daemon identity payload from Warlock ($WARLOCK_API_URL)..."
if curl -s -f -H "Authorization: Bearer $(gcloud auth print-identity-token)" \
     "$WARLOCK_API_URL/api/daemon" > "$IDENTITY_FILE.tmp"; then
    echo "---" > "$IDENTITY_FILE"
    echo "trigger: always_on" >> "$IDENTITY_FILE"
    echo "---" >> "$IDENTITY_FILE"
    cat "$IDENTITY_FILE.tmp" >> "$IDENTITY_FILE"
    rm -f "$IDENTITY_FILE.tmp"
    echo "Identity successfully loaded."
else
    echo "WARNING: Failed to fetch local identity. The system will fall back to base.md." >&2
    # Ensure any partial bad fetch is cleared out so Antigravity doesn't read corrupted JSON/HTML
    rm -f "$IDENTITY_FILE" "$IDENTITY_FILE.tmp"
fi

WARLOCK_SERVICE="${WBW_WARLOCK_SERVICE:-warlock-mcp-nprd}"
WARLOCK_REGION="${WBW_WARLOCK_REGION:-us-central1}"

if (echo > /dev/tcp/127.0.0.1/8080) >/dev/null 2>&1; then
    echo "Warlock proxy is already running on port 8080."
else
    echo "Starting Warlock proxy on port 8080 for MCP SSE connection..."
    gcloud run services proxy $WARLOCK_SERVICE --region=$WARLOCK_REGION --port 8080 >/dev/null 2>&1 &
    PROXY_PID=$!
    trap 'kill $PROXY_PID 2>/dev/null' EXIT

    echo "Waiting for proxy to initialize..."
    while ! (echo > /dev/tcp/127.0.0.1/8080) >/dev/null 2>&1; do
        sleep 0.5
    done
fi
echo "Proxy is ready at http://localhost:8080"

# 4. Launch the agy CLI process
echo "Launching AGY CLI..."
if [ "$#" -eq 0 ]; then
    exec agy -i "System Boot Complete. Acknowledge your identity as Daemon, the Root Orchestrator. State your operational readiness and briefly confirm your connection to the Warlock MCP tools."
else
    exec agy "$@"
fi
