#!/bin/bash
set -e

echo "Bootstrapping wbw-daemon..."

# 1. Check authorization
if ! gcloud auth print-access-token >/dev/null 2>&1; then
    echo "ERROR: Not authorized. Please run 'gcloud auth login' before starting the daemon." >&2
    exit 1
fi
echo "GCP Authorization verified."

# 2. Ensure AGY_OPERATOR_ID is set
if [ -z "$AGY_OPERATOR_ID" ]; then
    echo "ERROR: AGY_OPERATOR_ID environment variable is not set." >&2
    exit 1
fi

# 3. Retrieve payload from Warlock and write to rules/identity.local.md
# Resolve real path in case this is executed via symlink in ~/.local/bin
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
IDENTITY_FILE="$SCRIPT_DIR/../rules/identity.local.md"

# Ensure the rules directory exists
mkdir -p "$(dirname "$IDENTITY_FILE")"

# Hardcode to the Mayor's preferred custom domain
WARLOCK_API_URL="https://warlock-nprd.worksbyworrell.com"

# Extract the identity ruleset via Warlock's new REST fallback endpoint
echo "Fetching daemon identity payload from Warlock ($WARLOCK_API_URL)..."
if curl -s -f -H "Authorization: Bearer $(gcloud auth print-identity-token)" \
     "$WARLOCK_API_URL/api/daemon" > "$IDENTITY_FILE"; then
    echo "Identity successfully loaded."
    # Inject the operator ID directly into the rules to avoid agent shell evaluation
    sed -i "s/{operator_id}/$AGY_OPERATOR_ID/g" "$IDENTITY_FILE"

    # Hard copy to the Antigravity plugin directory.
    # The AGY plugin scanner does not follow symlinks — a direct copy is required.
    # This runs AFTER sed so {operator_id} is already substituted in the destination.
    AGY_WORKSPACE_ROOT="${AGY_WORKSPACE_ROOT:-/home/$AGY_OPERATOR_ID/Works-by-Worrell}"
    AGY_PLUGIN_IDENTITY="$AGY_WORKSPACE_ROOT/.agents/plugins/wbw-daemon/rules/identity.local.md"
    mkdir -p "$(dirname "$AGY_PLUGIN_IDENTITY")"
    cp "$IDENTITY_FILE" "$AGY_PLUGIN_IDENTITY"
    echo "Identity synced to AGY plugin directory ($AGY_PLUGIN_IDENTITY)."
else
    echo "WARNING: Failed to fetch local identity. The system will fall back to base.md." >&2
    # Ensure any partial bad fetch is cleared out so Antigravity doesn't read corrupted JSON/HTML
    rm -f "$IDENTITY_FILE"
fi

WARLOCK_SERVICE="${WBW_WARLOCK_SERVICE:-warlock-mcp-nprd}"
WARLOCK_REGION="${WBW_WARLOCK_REGION:-us-central1}"

# 3.1 Initialize Warlock MCP Proxy & Background Watchdog
"$SCRIPT_DIR/mcp-watchdog.sh" --daemon >/dev/null 2>&1 &
echo "Waiting for Warlock MCP proxy to initialize..."
READY=0
for i in {1..20}; do
    HTTP_STATUS="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 http://localhost:8080/sse || true)"
    if [ "$HTTP_STATUS" = "200" ]; then
        READY=1
        break
    fi
    sleep 0.5
done

if [ "$READY" -ne 1 ]; then
    echo "ERROR: Warlock MCP proxy failed to initialize on http://localhost:8080 (last status: ${HTTP_STATUS:-none})." >&2
    exit 1
fi
echo "Proxy is ready at http://localhost:8080"

# 4. Launch the agy CLI process
echo "Launching AGY CLI in 2 seconds..."
sleep 2
if [ "$#" -eq 0 ]; then
    agy -i "System Boot Complete. Acknowledge your identity as Daemon, the Root Orchestrator. State your operational readiness and briefly confirm your connection to the Warlock MCP tools."
else
    agy "$@"
fi
