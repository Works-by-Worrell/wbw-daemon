#!/bin/bash
set -e

echo "Bootstrapping wbw-daemon..."

# 1. Check authorization
if ! gcloud auth print-access-token >/dev/null 2>&1; then
    echo "ERROR: Not authorized. Please run 'gcloud auth login' before starting the daemon." >&2
    exit 1
fi
echo "GCP Authorization verified."

# 2. Ensure AGY_OPERATOR_ID is set
if [ -z "$AGY_OPERATOR_ID" ]; then
    echo "ERROR: AGY_OPERATOR_ID environment variable is not set." >&2
    exit 1
fi

# 3. Retrieve payload from Warlock and write to rules/identity.local.md
IDENTITY_FILE="$(dirname "$0")/../rules/identity.local.md"

# Ensure the rules directory exists
mkdir -p "$(dirname "$IDENTITY_FILE")"

# Dynamically resolve the Cloud Run URL to avoid proxy dependency during bootstrap
echo "Resolving direct Warlock Cloud Run URL..."
WARLOCK_SERVICE="${WBW_WARLOCK_SERVICE:-warlock-mcp-nprd}"
WARLOCK_REGION="${WBW_WARLOCK_REGION:-us-central1}"
WARLOCK_API_URL=$(gcloud run services describe $WARLOCK_SERVICE --region=$WARLOCK_REGION --format='value(status.url)' 2>/dev/null)

if [ -z "$WARLOCK_API_URL" ]; then
    echo "ERROR: Failed to resolve Warlock service URL." >&2
    exit 1
fi

# Extract the identity ruleset via Warlock's new REST fallback endpoint
echo "Fetching daemon identity payload from Warlock ($WARLOCK_API_URL)..."
if curl -s -f -H "Authorization: Bearer $(gcloud auth print-identity-token)" \
     "$WARLOCK_API_URL/api/daemon" > "$IDENTITY_FILE"; then
    echo "Identity successfully loaded."
else
    echo "WARNING: Failed to fetch local identity. The system will fall back to base.md." >&2
    # Ensure any partial bad fetch is cleared out so Antigravity doesn't read corrupted JSON/HTML
    rm -f "$IDENTITY_FILE"
fi

# 4. Launch the agy CLI process
echo "Launching AGY CLI..."
exec agy "$@"
