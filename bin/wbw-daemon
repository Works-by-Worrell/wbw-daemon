#!/bin/bash
set -e

echo "Bootstrapping wbw-daemon..."

# 1. Check for GITHUB_TOKEN
if [ -z "$GITHUB_TOKEN" ]; then
    echo "ERROR: GITHUB_TOKEN environment variable is not set. Required for decoupled Edge-Execution." >&2
    exit 1
fi
echo "GitHub Authorization verified."

# 2. Ensure AGY_OPERATOR_ID is set
if [ -z "$AGY_OPERATOR_ID" ]; then
    echo "ERROR: AGY_OPERATOR_ID environment variable is not set." >&2
    exit 1
fi

# 3. Retrieve payload from Warlock and write to rules/identity.local.md
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
IDENTITY_FILE="$SCRIPT_DIR/../rules/identity.local.md"

mkdir -p "$(dirname "$IDENTITY_FILE")"

echo "Fetching daemon identity payload from GitHub API (Edge-Execution)..."
if curl -s -f -H "Authorization: Bearer $GITHUB_TOKEN" \
     -H "Accept: application/vnd.github.v3.raw" \
     "https://api.github.com/repos/Works-by-Worrell/wbw-config-private/contents/agents/daemon.md" > "$IDENTITY_FILE"; then
    echo "Identity successfully loaded."
    sed -i "s/{operator_id}/$AGY_OPERATOR_ID/g" "$IDENTITY_FILE"

    AGY_WORKSPACE_ROOT="${AGY_WORKSPACE_ROOT:-/home/$AGY_OPERATOR_ID/Works-by-Worrell}"
    AGY_PLUGIN_IDENTITY="$AGY_WORKSPACE_ROOT/.agents/plugins/wbw-daemon/rules/identity.local.md"
    mkdir -p "$(dirname "$AGY_PLUGIN_IDENTITY")"
    cp "$IDENTITY_FILE" "$AGY_PLUGIN_IDENTITY"
    echo "Identity synced to AGY plugin directory ($AGY_PLUGIN_IDENTITY)."
else
    echo "WARNING: Failed to fetch local identity. The system will fall back to base.md." >&2
    rm -f "$IDENTITY_FILE"
fi

echo "Warlock MCP Proxy is bypassed. Relying on local uvx/Docker sidecar."

# 4. Launch the agy CLI process
echo "Launching AGY CLI in 2 seconds..."
sleep 2
if [ "$#" -eq 0 ]; then
    agy --agent daemon -i "System Boot Complete. Acknowledge your identity as Daemon, the Root Orchestrator. State your operational readiness and briefly confirm your connection to the Warlock MCP tools."
else
    agy --agent daemon "$@"
fi
